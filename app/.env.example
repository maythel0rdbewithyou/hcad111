# Copy to .env.production.local before `npm run build` for deployment.
# Public URL of parcels.pmtiles in your R2 bucket (r2.dev subdomain or custom domain).
VITE_PMTILES_URL=https://pub-XXXXXXXXXXXXXXXX.r2.dev/parcels.pmtiles
# Optional: host the search index somewhere other than the app itself.
# VITE_SEARCH_BASE_URL=https://example.com/search
